                "UNICODE",
                "_UNICODE",
                "PICO_BOARD=\"pico\"",
                "PICO_PLATFORM=\"rp2040\"",
                "PICO_ON_DEVICE=1",
                "LIB_PICO_STDLIB=1"
            ],
            "compilerPath": "C:/msys64/ucrt64/bin/arm-none-eabi-gcc.exe",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-arm",
