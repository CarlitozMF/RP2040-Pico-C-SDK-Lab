{
    "configurations": [
        {
            "name": "Linux / GCC ARM",
            "includePath": [
                "${workspaceFolder}/projects/**",
                "${workspaceFolder}/libs/pico-sdk/src/**"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "PICO_BOARD=\"pico\"",
                "PICO_PLATFORM=\"rp2040\"",
                "PICO_ON_DEVICE=1",
                "LIB_PICO_STDLIB=1"
            ],
            "compilerPath": "/usr/bin/arm-none-eabi-gcc",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-arm",
            "compileCommands": "${workspaceFolder}/projects/01_Blink/build/compile_commands.json"
        },
        {
            "name": "Win32 / Git Bash",
            "includePath": [
